{
  "name": "fit-route",
  "repository": "git@gitlab.com:nwholloway/fit-route.git",
  "author": "Nick Holloway <nick.holloway@pyrites.org.uk>",
  "private": true,
  "scripts": {
    "start": "browser-sync start -s public -f public --port ${C9_PORT:-8080} --listen ${C9_IP:-127.0.0.1} --no-ui --no-open",
    "format": "prettier --write 'public/js/**/*.js' --write 'public/index.html' --write 'public/css/**/*.css'"
  },
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "prettier": "^2.8.3"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@capacitor/filesystem": "^7.1.4",
    "@capacitor/share": "^7.0.2",
    "@capacitor/status-bar": "^7.0.3",
    "@capawesome/capacitor-android-edge-to-edge-support": "^7.2.3"
  }
}
